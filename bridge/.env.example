# Bridge worker config. Copy to bridge/.env (gitignored) and fill in.
SUPABASE_URL=https://zkxoyiiccqsovdtkxgpn.supabase.co
# Service role key: Supabase Dashboard -> Project Settings -> API -> service_role
# (or the sb_secret_... key). SECRET. Stays only in this file, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# Deploy after a successful commit. This pushes to GitHub AND publishes the fresh
# build to Cloudflare Pages (direct upload). The bridge runs `npm run build` first,
# so dist/ exists.
DEPLOY_CMD=git push && npx --yes wrangler@latest pages deploy dist --project-name fcdiamante --branch main --commit-dirty=true

# Public URL shown as "Ver despliegue" in the cards.
DEPLOY_URL=https://fcdiamante.pages.dev

# Cloudflare credentials for the deploy command above.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=c729a73bbc9dd93ea33cdd6be6ae51fc

# Poll interval in ms.
POLL_MS=15000
