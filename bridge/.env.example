# Bridge worker config. Copy to bridge/.env (gitignored) and fill in.
SUPABASE_URL=https://zkxoyiiccqsovdtkxgpn.supabase.co
# Service role key: Supabase Dashboard -> Project Settings -> API -> service_role.
# SECRET. Stays only in this file, never committed.
SUPABASE_SERVICE_ROLE_KEY=

# How to deploy after a successful commit. Default just pushes (a connected host
# like Vercel/Cloudflare Pages then auto-builds). Override if you deploy differently.
DEPLOY_CMD=git push

# Public URL of the deployed app, shown as "Ver despliegue" in the cards. Optional.
DEPLOY_URL=

# Poll interval in ms.
POLL_MS=15000
